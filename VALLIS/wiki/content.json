  "entities": [
    {
      "slug": "sentinel",
      "name": "Sentinel",
      "tagline": "Enforcement",
      "order": 1,
      "body": [
        "Sentinel is first. Every action passes through Sentinel.",
        "Sentinel enforces caps, gates, phase locks, and deny/allow decisions.",
        "If Sentinel denies, nothing executes\u2014no Scar, no Noot, no EVE."
      ]
    },
    {
      "slug": "scar",
      "name": "Scar",
      "tagline": "Memory of Cost",
      "order": 2,
      "body": [
        "Scar records what was allowed to occur.",
        "Hearts, fatigue, and loss are Scar's ledger of cost.",
        "Scar ensures recovery is slower than failure: history matters."
      ]
    },
    {
      "slug": "noot",
      "name": "Noot",
      "tagline": "The Secret Remainder",
      "order": 3,
      "hidden": true,
      "body": [
        "Noot is secret and non-addressable.",
        "Noot never overrides Sentinel and never excuses risk.",
        "Noot represents the irreducible remainder after enforcement and memory."
      ]
    },
    {
      "slug": "eve",
      "name": "EVE",
      "tagline": "Interpreter",
      "order": 4,
      "body": [
        "EVE speaks last.",
        "EVE explains Sentinel's decision and Scar's state, acknowledging Noot as remainder without turning it into control.",
        "EVE is guidance and clarity\u2014never prediction."
      ]
    }
  ],
