#!/bin/bash
# ADMENSION AdSense Manager CLI
# Usage: adsense [command] or just 'adsense' for menu

export PATH="/usr/local/share/google-cloud-sdk/bin:$PATH"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Config
SITE="garebear99.github.io"
PUB_ID="pub-5584590642779290"
LOG_FILE="$HOME/.adsense-status.log"
PLIST="$HOME/Library/LaunchAgents/com.admension.adsense-checker.plist"
CHECKER_SCRIPT="$HOME/bin/check-adsense-status.sh"

show_header() {
  clear
  echo -e "${PURPLE}╔════════════════════════════════════════════════════════╗${NC}"
  echo -e "${PURPLE}║${NC}    ${BOLD}${CYAN}ADMENSION AdSense Manager${NC}                          ${PURPLE}║${NC}"
  echo -e "${PURPLE}║${NC}    Site: ${GREEN}$SITE${NC}                    ${PURPLE}║${NC}"
  echo -e "${PURPLE}╚════════════════════════════════════════════════════════╝${NC}"
  echo ""
}

get_status() {
  TOKEN=$(gcloud auth application-default print-access-token 2>/dev/null)
  if [ -z "$TOKEN" ]; then
    echo "AUTH_ERROR"
    return
  fi
  RESPONSE=$(curl -s -H "Authorization: Bearer $TOKEN" \
    -H "x-goog-user-project: admension-adsense-api" \
    "https://adsense.googleapis.com/v2/accounts/$PUB_ID/sites/$SITE" 2>/dev/null)
  echo "$RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin).get('state','UNKNOWN'))" 2>/dev/null
}

cmd_status() {
  echo -e "${CYAN}Checking AdSense status...${NC}"
  echo ""
  STATUS=$(get_status)
  
  if [ "$STATUS" = "READY" ]; then
    echo -e "  Site Status: ${GREEN}${BOLD}✅ APPROVED${NC}"
    echo -e "  ${GREEN}Ads are now live!${NC}"
  elif [ "$STATUS" = "GETTING_READY" ]; then
    echo -e "  Site Status: ${YELLOW}${BOLD}⏳ GETTING_READY${NC}"
    echo -e "  ${YELLOW}Google is reviewing your site...${NC}"
  elif [ "$STATUS" = "AUTH_ERROR" ]; then
    echo -e "  Site Status: ${RED}${BOLD}❌ AUTH ERROR${NC}"
    echo -e "  ${RED}Run: gcloud auth application-default login${NC}"
  else
    echo -e "  Site Status: ${RED}${BOLD}❓ $STATUS${NC}"
  fi
  echo ""
}

cmd_full_status() {
  echo -e "${CYAN}Fetching full account details...${NC}"
  echo ""
  TOKEN=$(gcloud auth application-default print-access-token 2>/dev/null)
  
  echo -e "${BOLD}Account:${NC}"
  curl -s -H "Authorization: Bearer $TOKEN" \
    -H "x-goog-user-project: admension-adsense-api" \
    "https://adsense.googleapis.com/v2/accounts/$PUB_ID" | python3 -m json.tool 2>/dev/null
  
  echo ""
  echo -e "${BOLD}Site:${NC}"
  curl -s -H "Authorization: Bearer $TOKEN" \
    -H "x-goog-user-project: admension-adsense-api" \
    "https://adsense.googleapis.com/v2/accounts/$PUB_ID/sites/$SITE" | python3 -m json.tool 2>/dev/null
  echo ""
}

cmd_log() {
  echo -e "${CYAN}Recent log entries:${NC}"
  echo ""
  if [ -f "$LOG_FILE" ]; then
    tail -20 "$LOG_FILE"
  else
    echo -e "${YELLOW}No log file yet.${NC}"
  fi
  echo ""
}

cmd_checker_status() {
  echo -e "${CYAN}Checker daemon status:${NC}"
  echo ""
  if launchctl list 2>/dev/null | grep -q "com.admension.adsense-checker"; then
    echo -e "  Daemon: ${GREEN}${BOLD}✅ RUNNING${NC}"
    echo -e "  Schedule: 9 AM and 6 PM daily"
  else
    echo -e "  Daemon: ${RED}${BOLD}❌ NOT RUNNING${NC}"
  fi
  echo ""
}

cmd_start() {
  echo -e "${CYAN}Starting AdSense checker...${NC}"
  launchctl load -w "$PLIST" 2>/dev/null
  rm -f "$HOME/.adsense-checker-started"  # Reset to show activation notification
  bash "$CHECKER_SCRIPT" 2>/dev/null
  echo -e "${GREEN}✅ Checker started!${NC}"
  echo ""
}

cmd_stop() {
  echo -e "${CYAN}Stopping AdSense checker...${NC}"
  launchctl unload "$PLIST" 2>/dev/null
  rm -f "$HOME/.adsense-checker-started"
  echo -e "${YELLOW}🔕 Checker stopped.${NC}"
  echo ""
}

cmd_check_now() {
  echo -e "${CYAN}Running manual check...${NC}"
  echo ""
  bash "$CHECKER_SCRIPT"
  echo ""
}

cmd_open_dashboard() {
  echo -e "${CYAN}Opening AdSense dashboard...${NC}"
  open "https://www.google.com/adsense/new/u/0/$PUB_ID/home"
  echo -e "${GREEN}✅ Opened in browser${NC}"
  echo ""
}

cmd_open_sites() {
  echo -e "${CYAN}Opening AdSense sites page...${NC}"
  open "https://www.google.com/adsense/new/u/0/$PUB_ID/sites"
  echo -e "${GREEN}✅ Opened in browser${NC}"
  echo ""
}

cmd_verify_setup() {
  echo -e "${CYAN}Verifying setup...${NC}"
  echo ""
  
  # Check ads.txt
  echo -n "  ads.txt at root: "
  if curl -s "https://$SITE/ads.txt" | grep -q "$PUB_ID"; then
    echo -e "${GREEN}✅ Found${NC}"
  else
    echo -e "${RED}❌ Missing${NC}"
  fi
  
  # Check AdSense code
  echo -n "  AdSense code on site: "
  COUNT=$(curl -s "https://$SITE/ADMENSION/" | grep -c "ca-$PUB_ID")
  if [ "$COUNT" -gt 0 ]; then
    echo -e "${GREEN}✅ Found ($COUNT instances)${NC}"
  else
    echo -e "${RED}❌ Not found${NC}"
  fi
  
  # Check daemon
  echo -n "  Checker daemon: "
  if launchctl list 2>/dev/null | grep -q "com.admension.adsense-checker"; then
    echo -e "${GREEN}✅ Running${NC}"
  else
    echo -e "${YELLOW}⚠️ Not running${NC}"
  fi
  
  # Check gcloud auth
  echo -n "  Google Cloud auth: "
  if gcloud auth application-default print-access-token &>/dev/null; then
    echo -e "${GREEN}✅ Valid${NC}"
  else
    echo -e "${RED}❌ Expired${NC}"
  fi
  
  echo ""
}

cmd_help() {
  echo -e "${BOLD}Usage:${NC} adsense [command]"
  echo ""
  echo -e "${BOLD}Commands:${NC}"
  echo "  status      Quick status check"
  echo "  full        Full API status (JSON)"
  echo "  check       Run manual check now"
  echo "  log         View recent log"
  echo "  start       Start the checker daemon"
  echo "  stop        Stop the checker daemon"
  echo "  verify      Verify full setup"
  echo "  dashboard   Open AdSense dashboard"
  echo "  sites       Open AdSense sites page"
  echo "  help        Show this help"
  echo ""
  echo "Or run 'adsense' with no args for interactive menu."
  echo ""
}

show_menu() {
  show_header
  cmd_status
  cmd_checker_status
  
  echo -e "${BOLD}Commands:${NC}"
  echo -e "  ${CYAN}1${NC}) Check status now"
  echo -e "  ${CYAN}2${NC}) View full API status"
  echo -e "  ${CYAN}3${NC}) View log"
  echo -e "  ${CYAN}4${NC}) Verify setup"
  echo -e "  ${CYAN}5${NC}) Start checker daemon"
  echo -e "  ${CYAN}6${NC}) Stop checker daemon"
  echo -e "  ${CYAN}7${NC}) Open AdSense dashboard"
  echo -e "  ${CYAN}8${NC}) Open Sites page"
  echo -e "  ${CYAN}q${NC}) Quit"
  echo ""
  echo -n "Select: "
}

interactive_menu() {
  while true; do
    show_menu
    read -r choice
    echo ""
    case $choice in
      1) cmd_check_now; read -p "Press Enter to continue..." ;;
      2) cmd_full_status; read -p "Press Enter to continue..." ;;
      3) cmd_log; read -p "Press Enter to continue..." ;;
      4) cmd_verify_setup; read -p "Press Enter to continue..." ;;
      5) cmd_start; read -p "Press Enter to continue..." ;;
      6) cmd_stop; read -p "Press Enter to continue..." ;;
      7) cmd_open_dashboard ;;
      8) cmd_open_sites ;;
      q|Q) echo -e "${GREEN}Goodbye!${NC}"; exit 0 ;;
      *) echo -e "${RED}Invalid option${NC}"; sleep 1 ;;
    esac
  done
}

# Main
case "${1:-}" in
  status)    cmd_status ;;
  full)      cmd_full_status ;;
  check)     cmd_check_now ;;
  log)       cmd_log ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  verify)    cmd_verify_setup ;;
  dashboard) cmd_open_dashboard ;;
  sites)     cmd_open_sites ;;
  help|--help|-h) cmd_help ;;
  "") interactive_menu ;;
  *) echo "Unknown command: $1"; cmd_help; exit 1 ;;
esac
